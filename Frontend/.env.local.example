# CredLayer Frontend Environment Variables

# Backend API URL
# The URL where your CredLayer backend is running
# Default: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Relayer Service URL
# The URL where your attestation relayer service is running
# Default: http://localhost:3001/api/v1/attestations/issue
NEXT_PUBLIC_RELAYER_URL=http://localhost:3001/api/v1/attestations/issue

# Solana RPC URL (Optional - defaults to Devnet)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Add other environment variables as needed
