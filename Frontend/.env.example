# CredLayer API Configuration
VITE_API_BASE_URL=https://api.credlayer.io/v1
VITE_API_TIMEOUT=30000

# Environment
VITE_APP_ENV=development

# Optional: API Key for public endpoints (if needed)
# VITE_PUBLIC_API_KEY=

# WebSocket URL (for real-time updates)
VITE_WS_URL=wss://api.credlayer.io/ws

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WEBHOOKS=true
VITE_ENABLE_AI_ANALYSIS=true
