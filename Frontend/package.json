{
  "name": "credlayer-frontend",
  "description": "CredLayer - Reputation Layer for Web3 with Next.js, Tailwind, @solana/kit, Anchor",
  "keywords": [
    "anchor",
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "credlayer",
    "reputation"
  ],
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "anchor-build": "cd anchor && anchor build --ignore-keys",
    "anchor-test": "cd anchor && anchor build --ignore-keys && cargo test",
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "codama:js": "codama run js",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "setup": "npm run anchor-build && npm run codama:js",
    "start": "next start"
  },
  "dependencies": {
    "@metamask/connect-evm": "^2.1.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.101.4",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/svm": "^2.21.0",
    "accounts": "^0.14.12",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "debug": "^4.4.3",
    "lucide-react": "^0.469.0",
    "motion": "^11.18.0",
    "next": "15.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "sonner": "^2.0.7",
    "supports-color": "^11.0.0",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.55.11",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
