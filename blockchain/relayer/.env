# CredLayer Relayer Configuration

# Port for the relayer service
PORT=3001

# Solana RPC endpoint (Devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Base58-encoded private key of the issuer account
# This account must have SOL for transaction fees and authority to issue attestations
# IMPORTANT: Replace with your actual issuer private key
ISSUER_PRIVATE_KEY=YOUR_ISSUER_PRIVATE_KEY_HERE

# Credential PDA (Program Derived Address)
# This is the credential account address from your SAS setup
# IMPORTANT: Replace with your actual credential PDA
CREDENTIAL_PDA=YOUR_CREDENTIAL_PDA_HERE

# Schema PDA (Program Derived Address)  
# This is the schema account address from your SAS setup
# IMPORTANT: Replace with your actual schema PDA
SCHEMA_PDA=YOUR_SCHEMA_PDA_HERE
